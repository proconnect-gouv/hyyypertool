    "zod": "4.6.7"
  },
  "devDependencies": {
    "@~/config.typescript": "workspace:*",
    "@electric-sql/pglite": "0.5.11",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "ts-dedent": "2.3.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45",
    "pg": ">=8"
  }
}

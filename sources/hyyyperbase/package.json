{
  "name": "@~/hyyyperbase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src": "./src/index.ts",
    "#src/*": "./src/*.ts",
    "#src/testing": "./src/testing/index.ts",
    "#src/testing/*": "./src/testing/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",

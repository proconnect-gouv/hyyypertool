{
  "name": "@~/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*/index.ts"
  },
  "exports": {
    "./config": "./src/config/index.ts",
    "./routes": "./src/routes/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf node_modules/.cache/tsc",
    "dev:api": "bun run dev:api:clean && bun run dev:api:tsc && bun run dev:api:cp && bun run dev:api:format",
    "dev:api:clean": "bun run clean",
    "dev:api:cp": "cp ./node_modules/.cache/tsc/src/routes/index.d.ts 'src/routes.d.ts'",
    "dev:api:format": "prettier --write src/routes.d.ts",
    "dev:api:tsc": "bun run build",
    "start:bun": "bun run src/bun/index.ts",
    "start:node": "tsx src/node/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/sentry": "1.2.2",
    "@hono/zod-validator": "0.9.1",
    "@proconnect-gouv/proconnect.annuaire_entreprises": "3.0.6",
    "@proconnect-gouv/proconnect.api_entreprise": "2.3.0",
    "@proconnect-gouv/proconnect.core": "1.1.1",
    "@proconnect-gouv/proconnect.crisp": "1.0.1",
    "@proconnect-gouv/proconnect.identite": "14.0.0",
    "@proconnect-gouv/proconnect.identite.runtime": "0.4.0",
    "@sentry/browser": "11.8.0",
    "@sentry/conventions": "0.27.0",
    "@sentry/core": "11.8.0",
    "@sentry/node": "11.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@~/hyyyperbase": "workspace:*",
    "@~/identite-proconnect": "workspace:*",
    "await-to-js": "3.0.0",
    "consola": "3.4.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "hono-sessions": "0.8.1",
    "hono-slotify": "workspace:*",
    "is-disposable-email-domain": "1.0.7",
    "jose": "6.2.13",
    "lodash.sortby": "4.7.0",
    "nprogress": "0.2.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "preact": "10.29.8",
    "preact-render-to-string": "6.8.1",
    "rate-limiter-flexible": "11.2.3",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "static-path": "0.0.4",
    "tailwind-dsfr": "workspace:*",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.3",
    "ts-dedent": "2.3.0",
    "ts-pattern": "5.9.2",
    "tsx": "4.23.15",
    "type-fest": "5.10.0",
    "unified": "11.0.5",
    "youch": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@~/config.typescript": "workspace:*",
    "@happy-dom/global-registrator": "21.0.4",
    "@types/lodash.sortby": "4.7.9",
    "@types/nprogress": "0.2.3",
